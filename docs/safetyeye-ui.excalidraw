   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "fontSize": 13,
   "fontFamily": 2,
   "text": "Detection box\n  1.5px normally, 2.4px when inside a zone\n  corner ticks at min(13, 28% of the side)\n  mint = person outside \u00b7 red = person inside\n  grey = object \u00b7 blue = object in the fire exit\n  fades to 25% as a track goes unmatched",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Detection box\n  1.5px normally, 2.4px when inside a zone\n  corner ticks at min(13, 28% of the side)\n  mint = person outside \u00b7 red = person inside\n  grey = object \u00b7 blue = object in the fire exit\n  fades to 25% as a track goes unmatched",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
