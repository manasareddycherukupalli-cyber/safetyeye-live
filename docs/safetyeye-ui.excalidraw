   "fontSize": 13,
   "fontFamily": 2,
   "text": "Zone\n  dashed 2px, 7/5 dash, 12% fill\n  label tag sits above, clamped inside the frame\n  red = danger zone \u00b7 blue = fire exit\n",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Zone\n  dashed 2px, 7/5 dash, 12% fill\n  label tag sits above, clamped inside the frame\n  red = danger zone \u00b7 blue = fire exit\n",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "e544",
   "type": "text",
   "x": 600,
   "y": 3070,
