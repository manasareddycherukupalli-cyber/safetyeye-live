  {
   "id": "e282",
   "type": "text",
   "x": 1165,
   "y": 1184,
   "width": 271.7,
   "height": 178.75,
   "angle": 0,
   "strokeColor": "#0f6b52",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1357544872,
   "version": 1,
   "versionNonce": 519301701,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "fontSize": 13,
   "fontFamily": 2,
   "text": "The stage is the product. Everything\nelse is chrome around it.\n\nLayers, bottom to top:\n  1  <video> (or the demo canvas)\n  2  #overlay canvas \u2014 zones + boxes\n  3  .hud \u2014 pills and stats, no taps\n  4  .alarm-flash \u2014 red inset glow\n\nBoxes ease toward the detection at\n60fps; detection itself runs at 12fps.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The stage is the product. Everything\nelse is chrome around it.\n\nLayers, bottom to top:\n  1  <video> (or the demo canvas)\n  2  #overlay canvas \u2014 zones + boxes\n  3  .hud \u2014 pills and stats, no taps\n  4  .alarm-flash \u2014 red inset glow\n\nBoxes ease toward the detection at\n60fps; detection itself runs at 12fps.",
   "lineHeight": 1.25,
   "autoResize": true
  },
